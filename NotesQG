/* ════════════════════════════
   QUIZ ENGINE
════════════════════════════ */
let currentQuiz = [];
let currentQ    = 0;
let score       = 0;
let answered    = false;
let quizType    = '';
let quizModal   = null;

document.addEventListener('DOMContentLoaded', () => {
  quizModal = new bootstrap.Modal(document.getElementById('quizModal'));
});

function startQuiz(type) {
  if (!QUESTIONS[type]) {
    alert('Quiz for this category is coming soon!'); return;
  }
  quizType    = type;
  currentQ    = 0;
  score       = 0;
  answered    = false;
  currentQuiz = shuffle([...QUESTIONS[type]]).slice(0, 10);
  document.getElementById('quizPlay').style.display  = 'block';
  document.getElementById('quizScore').style.display = 'none';
  document.getElementById('qCategory').textContent = CAT_LABELS[type] || type;
  renderQuestion();
  quizModal.show();
}

function shuffle(arr) {
  for (let i=arr.length-1;i>0;i--) {
    const j=Math.floor(Math.random()*(i+1));
    [arr[i],arr[j]]=[arr[j],arr[i]];
  }
  return arr;
}

function renderQuestion() {
  const q = currentQuiz[currentQ];
  document.getElementById('qNumber').textContent = `Question ${currentQ+1} of ${currentQuiz.length}`;
  document.getElementById('qProgressBar').style.width = `${((currentQ)/currentQuiz.length)*100}%`;
  document.getElementById('qText').textContent = q.q;
  document.getElementById('qExplain').style.display = 'none';
  const opts = document.getElementById('qOptions');
  opts.innerHTML = '';
  q.options.forEach((opt,i) => {
    const btn = document.createElement('button');
    btn.className = 'q-option d-block w-100';
    btn.textContent = opt;
    btn.onclick = () => selectAnswer(i);
    opts.appendChild(btn);
  });
  answered = false;
}

function selectAnswer(idx) {
  if (answered) return;
  answered = true;
  const q = currentQuiz[currentQ];
  const btns = document.querySelectorAll('.q-option');
  btns.forEach(b => b.disabled = true);
  btns[idx].classList.add(idx === q.answer ? 'correct' : 'wrong');
  if (idx !== q.answer) btns[q.answer].classList.add('correct');
  if (idx === q.answer) score++;
  const exp = document.getElementById('qExplain');
  exp.innerHTML = `<i class="fas fa-info-circle me-2 text-primary"></i>${q.explain}`;
  exp.style.display = 'block';
  setTimeout(() => {
    currentQ++;
    if (currentQ < currentQuiz.length) {
      renderQuestion();
    } else {
      showScore();
    }
  }, 1600);
}

function showScore() {
  document.getElementById('quizPlay').style.display  = 'none';
  document.getElementById('quizScore').style.display = 'block';
  document.getElementById('qProgressBar').style.width = '100%';
  const pct = Math.round((score/currentQuiz.length)*100);
  document.getElementById('scoreBig').textContent = `${score}/${currentQuiz.length}`;
  let msg, detail;
  if(pct>=80){ msg="🎉 Excellent!"; detail="Amazing work! You really know your stuff!"; }
  else if(pct>=60){ msg="👍 Good Job!"; detail="Nice effort! Review the missed questions and try again."; }
  else if(pct>=40){ msg="📚 Keep Practising!"; detail="Don't give up — read your notes and try again!"; }
  else { msg="😊 Keep Trying!"; detail="Read through the chapter notes and give it another shot!"; }
  document.getElementById('scoreMsg').textContent    = msg;
  document.getElementById('scoreDetail').textContent = detail;
}

function retryQuiz() { startQuiz(quizType); }
