  .quiz-card:hover { transform:translateY(-4px); box-shadow:0 10px 28px rgba(0,0,0,.16); }
  .quiz-card .quiz-header {
    padding:30px 24px 20px; color:#fff;
    font-family:'Saira',sans-serif;
  }
  .quiz-card .quiz-icon { font-size:2.5rem; margin-bottom:10px; display:block; }
  .quiz-card .quiz-title { font-size:1.3rem; font-weight:700; }
  .quiz-card .quiz-body { background:#fff; padding:20px 24px; }
  .quiz-card .quiz-body p { font-size:.88rem; color:#6c757d; }
  .quiz-card .quiz-body ul { font-size:.85rem; color:#495057; padding-left:18px; }
  .quiz-card .btn-quiz {
    width:100%; border-radius:10px; font-weight:700;
    padding:10px; font-size:.95rem;
  }
  .q1-header { background:linear-gradient(135deg,#0d6efd,#0a58ca); }
  .q2-header { background:linear-gradient(135deg,#198754,#20c997); }
  .q3-header { background:linear-gradient(135deg,#6610f2,#e83e8c); }

  /* ── Quiz 3 category picker ── */
  .cat-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:12px; }
  .cat-btn {
    border-radius:12px; border:2px solid #dee2e6; background:#fff;
    padding:16px 10px; text-align:center; cursor:pointer; transition:all .2s;
    font-size:.88rem; font-weight:600; color:#495057;
  }
  .cat-btn:hover, .cat-btn.selected {
    border-color: var(--cls-color1); background:#e7f1ff; color: var(--cls-color1);
  }
  .cat-btn .cat-icon { font-size:1.6rem; display:block; margin-bottom:6px; }

  /* ── Games section ── */
  .game-card {
    border-radius:14px; border:1px solid #e9ecef; overflow:hidden;
    background:#fff; text-align:center; padding:30px 20px;
    transition:transform .2s, box-shadow .2s;
  }
  .game-card:hover { transform:translateY(-4px); box-shadow:0 8px 24px rgba(0,0,0,.12); }
  .game-card .game-icon { font-size:3rem; margin-bottom:12px; display:block; }
  .game-card .game-title { font-weight:700; font-size:1rem; margin-bottom:6px; }
  .game-card .game-desc  { font-size:.82rem; color:#6c757d; margin-bottom:14px; }

  /* ── Quiz modal ── */
  #quizModal .modal-content { border-radius:16px; overflow:hidden; border:none; }
  #quizModal .modal-body    { padding:28px; }
  .q-number  { font-size:.82rem; color:#6c757d; font-weight:600; text-transform:uppercase; letter-spacing:.05em; }
  .q-text    { font-size:1.1rem; font-weight:700; margin:10px 0 18px; line-height:1.4; }
  .q-option  {
    width:100%; text-align:left; background:#f8f9fa; border:2px solid #e9ecef;
    border-radius:10px; padding:12px 16px; margin-bottom:8px;
    font-size:.92rem; font-weight:500; cursor:pointer; transition:all .18s;
  }
  .q-option:hover   { border-color: var(--cls-color1); background:#e7f1ff; }
  .q-option.correct { border-color:#198754!important; background:#d1e7dd!important; color:#0f5132!important; }
  .q-option.wrong   { border-color:#dc3545!important; background:#f8d7da!important; color:#842029!important; }
  .q-option:disabled{ cursor:default; }
  .q-progress { height:6px; border-radius:3px; background:#e9ecef; margin-bottom:18px; }
  .q-progress-bar { height:100%; border-radius:3px; background: var(--cls-gradient); transition:width .4s; }
  .score-circle {
    width:100px; height:100px; border-radius:50%;
    background: var(--cls-gradient); color:#fff;
    display:flex; align-items:center; justify-content:center;
    font-size:1.8rem; font-weight:700; margin:0 auto 16px;
  }

  /* Quiz 3 – category modal */
  #catModal .modal-content { border-radius:16px; border:none; overflow:hidden; }
</style>
