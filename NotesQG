  /* ════════════════════════════════
     CLASS HUB VARIABLES  (change only these per class)
     Class 4 = blue/purple theme
  ════════════════════════════════ */
  :root {
    --cls-color1: #0d6efd;
    --cls-color2: #6610f2;
    --cls-gradient: linear-gradient(135deg, #0d6efd, #6610f2);
    --cls-name: "Class 4";
    --cls-num: "4";
  }

  /* ── LOCK SCREEN (shown until correct password entered) ── */
  #lockScreen {
    position: fixed; inset: 0; z-index: 9999;
    background: var(--cls-gradient);
    display: flex; align-items: center; justify-content: center;
    flex-direction: column;
  }
  #lockScreen .lock-box {
    background: #fff; border-radius: 20px; padding: 44px 36px;
    text-align: center; width: 100%; max-width: 380px;
    box-shadow: 0 20px 60px rgba(0,0,0,.25);
  }
  .lock-icon { font-size: 3rem; color: var(--cls-color1); margin-bottom: 10px; }
  .lock-title { font-family:'Saira',sans-serif; font-size:1.6rem; font-weight:700; margin-bottom:4px; }
  .lock-sub   { font-size:.9rem; color:#6c757d; margin-bottom:22px; }
  #lockInput  {
    border-radius: 10px; text-align: center; font-size:1.1rem;
    letter-spacing:.14em; border: 2px solid #dee2e6;
    padding: 10px; width:100%; margin-bottom:6px;
    transition: border-color .2s;
  }
  #lockInput:focus { outline:none; border-color: var(--cls-color1); }
  #lockError { color:#dc3545; font-size:.85rem; height:18px; margin-bottom:10px; }
  #lockBtn {
    width:100%; border-radius:10px; padding:11px;
    font-size:1rem; font-weight:700; cursor:pointer; border:none;
    background: var(--cls-gradient); color:#fff; transition: opacity .2s;
  }
  #lockBtn:hover { opacity:.88; }
  .lock-hint { font-size:.78rem; color:#adb5bd; margin-top:14px; }

  /* ── PAGE CONTENT (hidden until unlocked) ── */
  #pageContent { display:none; }

  /* ── Class hero banner ── */
  .class-hero {
    background: var(--cls-gradient);
    padding: 44px 0 36px; color:#fff;
  }
  .class-hero .class-num-big {
    font-family:'Saira',sans-serif; font-size: 6rem; font-weight:700;
    line-height:1; opacity:.2; position:absolute; right:30px; top:10px;
  }
  .class-hero h1 { font-family:'Saira',sans-serif; font-size:2.2rem; font-weight:700; }
  .class-hero p  { opacity:.85; font-size:1rem; }
  .class-hero .breadcrumb-item a { color:rgba(255,255,255,.7); text-decoration:none; }
  .class-hero .breadcrumb-item.active { color:#fff; }
  .class-hero .breadcrumb-divider { color:rgba(255,255,255,.5); }

  /* ── Section tabs ── */
  .hub-tabs .nav-link {
    border-radius: 12px; margin-right:6px; margin-bottom:6px;
    font-weight:600; font-size:.9rem; padding:8px 18px;
    border: 2px solid transparent; color:#495057;
    transition: all .2s;
  }
  .hub-tabs .nav-link:hover        { border-color: var(--cls-color1); color: var(--cls-color1); }
  .hub-tabs .nav-link.active        { background: var(--cls-gradient); border-color:transparent; color:#fff; }
  .hub-tabs-wrapper { background:#f8f9fa; border-radius:16px; padding:14px 16px; margin-bottom:28px; }

  /* ── Notes section ── */
  .notes-chapter {
    background:#fff; border-radius:14px; border:1px solid #e9ecef;
    padding:22px 24px; margin-bottom:16px;
    transition: box-shadow .2s, transform .2s;
  }
  .notes-chapter:hover { box-shadow: 0 4px 18px rgba(0,0,0,.1); transform:translateY(-2px); }
  .notes-chapter .ch-num {
    display:inline-flex; align-items:center; justify-content:center;
    width:38px; height:38px; border-radius:10px;
    background: var(--cls-gradient); color:#fff;
    font-weight:700; font-size:1rem; margin-right:12px; flex-shrink:0;
  }
  .notes-chapter .ch-subject-badge {
    font-size:.72rem; padding:3px 9px; border-radius:20px; margin-left:8px;
    font-weight:600; vertical-align:middle;
  }
  .notes-chapter .ch-title { font-weight:700; font-size:1.05rem; margin-bottom:2px; }
  .notes-chapter .ch-desc  { font-size:.85rem; color:#6c757d; margin-bottom:0; }
  .notes-chapter .btn-note {
    font-size:.83rem; padding:6px 14px; border-radius:8px;
    font-weight:600; white-space:nowrap;
  }

  /* Coming soon badge */
  .coming-soon {
    background:#fff3cd; border:1px dashed #ffc107; border-radius:14px;
    padding:40px 20px; text-align:center; color:#856404;
  }
  .coming-soon i { font-size:2.5rem; margin-bottom:10px; display:block; }

  /* ── Quiz cards ── */
  .quiz-card {
    border-radius:16px; border:none; overflow:hidden;
    box-shadow: 0 4px 18px rgba(0,0,0,.09);
    transition: transform .2s, box-shadow .2s; height:100%;
